@@ -89,5 +97,77 @@ public virtual DownloadSpecDecision IsSatisfiedBy(RemoteEpisode subject, SearchC
 
             return DownloadSpecDecision.Accept();
         }
+
+        // Cumulative multi-episode packs (S01E01-05, E1-4, ...) contain both episodes that
+        // are already on disk and episodes that are still missing or need a quality upgrade.
+        // Such a pack is accepted as long as at least one monitored episode in it is wanted:
+        // either missing from disk (EpisodeFileId == 0) or upgradable with this release.
+        // Existing files that already meet the cutoff must not block the whole pack,
+        // otherwise the new episodes inside the pack could never be grabbed via
+        // RSS Sync or automatic search.
+        private DownloadSpecDecision IsSatisfiedByMultiEpisodePack(RemoteEpisode subject, QualityProfile qualityProfile)
+        {
+            var qualityReport = subject.ParsedEpisodeInfo.Quality;
+            var wantedFound = false;
+
+            foreach (var episode in subject.Episodes)
+            {
+                if (!episode.Monitored)
+                {
+                    _logger.Debug("Episode {0} is not monitored, ignoring it for the pack evaluation.", episode.Id);
+                    continue;
+                }
+
+                // Episode is missing from disk, it is always wanted.
+                if (episode.EpisodeFileId == 0)
+                {
+                    _logger.Debug("Episode {0} is missing from disk, pack contains a wanted episode.", episode.Id);
+                    wantedFound = true;
+                    break;
+                }
+
+                var file = episode.EpisodeFile.Value;
+                if (file == null)
+                {
+                    _logger.Debug("Episode {0} file is no longer available, skipping it for the pack evaluation.", episode.Id);
+                    continue;
+                }
+
+                var customFormats = _formatService.ParseCustomFormat(file);
+
+                if (!_upgradableSpecification.CutoffNotMet(qualityProfile,
+                        file.Quality,
+                        customFormats,
+                        qualityReport))
+                {
+                    _logger.Debug("Cutoff already met for episode {0}, it does not need the pack.", episode.Id);
+                    continue;
+                }
+
+                var upgradeableRejectReason = _upgradableSpecification.IsUpgradable(qualityProfile,
+                    file.Quality,
+                    customFormats,
+                    qualityReport,
+                    subject.CustomFormats);
+
+                if (upgradeableRejectReason == UpgradeableRejectReason.None)
+                {
+                    _logger.Debug("Episode {0} is upgradable, pack contains a wanted episode.", episode.Id);
+                    wantedFound = true;
+                    break;
+                }
+
+                _logger.Debug("Episode {0} exists on disk and is not upgradable with this release, due to: {1}", episode.Id, upgradeableRejectReason);
+            }
+
+            if (!wantedFound)
+            {
+                _logger.Debug("No monitored episode in the multi-episode pack is missing or upgradable, rejecting.");
+                return DownloadSpecDecision.Reject(DownloadRejectionReason.DiskCutoffMet, "Existing file meets cutoff for all monitored episodes in the pack");
+            }
+
+            _logger.Debug("Multi-episode pack contains at least one wanted (missing or upgradable) episode, accepting.");
+            return DownloadSpecDecision.Accept();
+        }
     }
 }
