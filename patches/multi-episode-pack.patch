+        private void SetUnwantedFiles(string hash, RemoteEpisode remoteEpisode)
+        {
+            try
+            {
+                // Only applicable for multi-episode packs where some episodes are already on disk.
+                if (remoteEpisode.Episodes.Count <= 1)
+                {
+                    return;
+                }
+
+                // Build a set of wanted episode numbers (missing or needing upgrade).
+                var wantedEpisodeNumbers = remoteEpisode.Episodes
+                    .Where(e => e.Monitored && e.EpisodeFileId == 0)
+                    .Select(e => e.EpisodeNumber)
+                    .ToHashSet();
+
+                // If all episodes are wanted, nothing to skip.
+                if (wantedEpisodeNumbers.Count == 0 || wantedEpisodeNumbers.Count == remoteEpisode.Episodes.Count)
+                {
+                    return;
+                }
+
+                var files = _proxy.GetTorrentFiles(hash, Settings);
+
+                if (files.Count <= 1)
+                {
+                    _logger.Debug("Torrent {0} has {1} file(s), cannot selectively skip files.", hash, files.Count);
+                    return;
+                }
+
+                var unwantedIndices = new List<int>();
+
+                for (var i = 0; i < files.Count; i++)
+                {
+                    var fileName = Path.GetFileNameWithoutExtension(files[i].Name);
+                    var parsed = Parser.Parser.ParseTitle(fileName);
+
+                    if (parsed == null || parsed.EpisodeNumbers.Length == 0)
+                    {
+                        // Can't determine what episodes this file covers — keep it (download).
+                        continue;
+                    }
+
+                    // If none of the episodes in this file are wanted, mark the file as unwanted.
+                    if (!parsed.EpisodeNumbers.Any(ep => wantedEpisodeNumbers.Contains(ep)))
+                    {
+                        unwantedIndices.Add(i);
+                        _logger.Debug("Marking file {0} (index {1}) as unwanted — episodes [{2}] are already on disk.", files[i].Name, i, string.Join(", ", parsed.EpisodeNumbers));
+                    }
+                }
+
+                if (unwantedIndices.Any())
+                {
+                    _logger.Info("Skipping {0} of {1} files in torrent {2} — only downloading wanted episodes.", unwantedIndices.Count, files.Count, hash);
+                    _proxy.SetTorrentFilesUnwanted(hash, unwantedIndices, Settings);
+                }
+            }
+            catch (Exception ex)
+            {
+                _logger.Warn(ex, "Failed to set unwanted files for torrent {0}. All files will be downloaded.", hash);
+            }
+        }
+
