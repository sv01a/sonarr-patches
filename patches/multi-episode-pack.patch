+        public List<TransmissionTorrentFile> GetTorrentFiles(string hash, TransmissionSettings settings)
+        {
+            var arguments = new Dictionary<string, object>
+            {
+                { "fields", new List<string> { "files" } },
+                { "ids", new List<string> { hash } }
+            };
+
+            var result = ProcessRequest("torrent-get", arguments, settings);
+            var torrents = ((JArray)result.Arguments["torrents"]).ToObject<List<JObject>>();
+
+            if (torrents == null || torrents.Count == 0)
+            {
+                return new List<TransmissionTorrentFile>();
+            }
+
+            var files = torrents[0]["files"]?.ToObject<List<TransmissionTorrentFile>>();
+
+            return files ?? new List<TransmissionTorrentFile>();
+        }
+
